# From Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-public-key

# Optional deployment override for Vercel / custom domains
VERCEL_URL=https://your-domain.vercel.app

# Service role key — server-only, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini API Key (from https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key

